# carry os environment reference.
# These are placeholders only. Export them in your shell or use your local
# environment manager. Commit no real secrets.

# Runtime environment: development, test, or production.
NODE_ENV=development

# NestJS API port.
PORT=3001

# Comma-separated browser origins allowed by the API CORS policy.
# Required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000

# NEAR testnet contract IDs. Fill these after deploying and initializing both contracts.
NEXT_PUBLIC_NEAR_VAULT_ID=carry-vault.testnet
NEXT_PUBLIC_NEAR_DEMO_NFT_ID=carry-demo-nft.testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# API read-only NEAR contract source-of-truth configuration.
NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org
NEAR_VAULT_ACCOUNT_ID=carry-vault.testnet
NEAR_DEMO_NFT_ACCOUNT_ID=carry-demo-nft.testnet

# API-wide per-IP request throttle (defaults: 100 requests per 60 seconds).
RATE_LIMIT_LIMIT=100
RATE_LIMIT_TTL_SECONDS=60
