# carry os environment reference.
# These are placeholders only. Export them in your shell or use your local
# environment manager. Commit no real secrets.

# Runtime environment: development, test, or production.
NODE_ENV=development

# NestJS API port.
PORT=3001

# Comma-separated browser origins allowed by the API CORS policy.
# Required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000

# Global API rate limiting. Both values must be positive integers.
# Maximum requests per client IP within the window, across matched API routes.
# Default 100, maximum 100000.
RATE_LIMIT_LIMIT=100

# Rate-limit window length in seconds. Default 60, maximum 86400.
RATE_LIMIT_TTL_SECONDS=60
