# carry os environment reference.
# These are placeholders only. Export them in your shell or use your local
# environment manager. Commit no real secrets.

# Runtime environment: development, test, or production.
NODE_ENV=development

# NestJS API port.
PORT=3001

# Comma-separated browser origins allowed by the API CORS policy.
# Required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000

# Backend NEAR Auth exchange (disabled until FastAuth JWT handoff is wired).
# Values must match the NEAR Auth app configuration; do not guess issuer/audience/JWKS.
AUTH_ENABLED=false
AUTH_SESSION_STORE=memory
NEAR_AUTH_ISSUER=
NEAR_AUTH_AUDIENCE=
NEAR_AUTH_JWKS_URI=
