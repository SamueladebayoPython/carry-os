{
  "name": "@carry-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "carry os NestJS REST API.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@carry-os/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "near-api-js": "7.4.0",
    "reflect-metadata": "0.2.2",
    "pg": "8.16.3",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@carry-os/config": "workspace:*",
    "@nestjs/cli": "12.0.12",
    "@types/node": "24.19.2",
    "@types/pg": "8.16.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "prisma": "7.10.1"
  }
}
